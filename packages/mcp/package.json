{
  "name": "@bndes/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "bin": {
    "bndes-naval-mcp": "./src/server.ts"
  },
  "scripts": {
    "start":        "TRANSPORT=stdio node --loader tsx/esm src/server.ts",
    "start:http":   "TRANSPORT=http node --loader tsx/esm src/server.ts",
    "ingest":       "tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@bndes/db":                 "file:../db",
    "@hono/node-server":         "^1.11.0",
    "hono":                      "^4.3.0",
    "zod":                       "^3.23.0",
    "dotenv":                    "^16.4.0"
  },
  "devDependencies": {
    "typescript":  "^5.4.0",
    "tsx":         "^4.7.0"
  }
}
