# PostgreSQL com extensão pgvector instalada
# Railway provisiona automaticamente; localmente: docker run -e POSTGRES_PASSWORD=senha pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:senha@localhost:5432/bndes_naval

# Voyage AI — embeddings 1024 dims, multilíngue
# Obter em: https://www.voyageai.com  (Anthropic recomenda para uso com Claude)
VOYAGE_API_KEY=pa-xxxxxxxxxxxx

# Caminho local para os arquivos .md convertidos pelo pipeline pdftotext
# Padrão: ./docs (relativo à raiz do monorepo)
DOCS_PATH=./docs

# Transporte do servidor MCP
# stdio  = Claude Desktop / desenvolvimento local
# http   = Railway / produção
TRANSPORT=stdio
PORT=3100

# Token exigido em /mcp no modo http ("Authorization: Bearer <token>").
# Recomendado em produção; vazio = endpoint aberto. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Anthropic API Key (usada pelo orquestrador de agentes, não pelo servidor MCP)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
